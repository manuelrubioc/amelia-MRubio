{
  "functions": [
    {
      "name": "consultarProductosTarjetas",
      "description": "Consulta el catálogo actualizado de tarjetas de crédito y débito disponibles con sus características, beneficios y requisitos",
      "actionType": "ConsumeWebService",
      "consumeWsActionName": "consultarProductosTarjetas",
      "inputParameters": [
        {
          "name": "tipoTarjeta",
          "description": "Tipo de tarjeta: credito o debito",
          "type": "STRING",
          "required": false
        },
        {
          "name": "rangoIngresos",
          "description": "Rango de ingresos del cliente",
          "type": "STRING",
          "required": false
        }
      ],
      "outputParameters": [
        {
          "name": "productos",
          "description": "Lista de productos de tarjetas disponibles",
          "type": "STRING"
        },
        {
          "name": "recomendacion",
          "description": "Producto recomendado basado en el perfil",
          "type": "STRING"
        }
      ]
    },
    {
      "name": "evaluarPerfilCrediticio",
      "description": "Realiza una pre-evaluación crediticia básica del cliente",
      "actionType": "ConsumeWebService",
      "consumeWsActionName": "evaluarPerfilCrediticio",
      "inputParameters": [
        {
          "name": "rfc",
          "description": "RFC del cliente",
          "type": "STRING",
          "required": false
        },
        {
          "name": "curp",
          "description": "CURP del cliente",
          "type": "STRING",
          "required": false
        },
        {
          "name": "ingresosMensuales",
          "description": "Ingresos mensuales declarados",
          "type": "STRING",
          "required": false
        }
      ],
      "outputParameters": [
        {
          "name": "scoreCredito",
          "description": "Puntuación crediticia",
          "type": "STRING"
        },
        {
          "name": "productosElegibles",
          "description": "Lista de productos para los que califica",
          "type": "STRING"
        },
        {
          "name": "limiteAprobado",
          "description": "Límite de crédito pre-aprobado",
          "type": "STRING"
        }
      ]
    },
    {
      "name": "calcularBeneficios",
      "description": "Calcula los beneficios y recompensas específicos para un producto y perfil de cliente",
      "actionType": "ConsumeWebService",
      "consumeWsActionName": "calcularBeneficios",
      "inputParameters": [
        {
          "name": "productoId",
          "description": "Identificador del producto de tarjeta",
          "type": "STRING",
          "required": false
        },
        {
          "name": "gastoMensualEstimado",
          "description": "Gasto mensual estimado del cliente",
          "type": "STRING",
          "required": false
        }
      ],
      "outputParameters": [
        {
          "name": "cashbackAnual",
          "description": "Cashback anual estimado",
          "type": "STRING"
        },
        {
          "name": "puntosRecompensa",
          "description": "Puntos de recompensa anuales",
          "type": "STRING"
        },
        {
          "name": "ahorroAnualidad",
          "description": "Ahorro en anualidad y comisiones",
          "type": "STRING"
        }
      ]
    },
    {
      "name": "registrarLeadVentas",
      "description": "Registra un lead calificado en el sistema de ventas",
      "actionType": "ConsumeWebService",
      "consumeWsActionName": "registrarLeadVentas",
      "inputParameters": [
        {
          "name": "datosContacto",
          "description": "Información de contacto del cliente",
          "type": "STRING",
          "required": false
        },
        {
          "name": "productoInteres",
          "description": "Producto de interés",
          "type": "STRING",
          "required": false
        },
        {
          "name": "scoreCalificacion",
          "description": "Puntuación de calificación del lead",
          "type": "STRING",
          "required": false
        }
      ],
      "outputParameters": [
        {
          "name": "numeroReferencia",
          "description": "Número de referencia del lead",
          "type": "STRING"
        },
        {
          "name": "fechaSeguimiento",
          "description": "Fecha programada para seguimiento",
          "type": "STRING"
        },
        {
          "name": "ejecutivoAsignado",
          "description": "Ejecutivo asignado al lead",
          "type": "STRING"
        }
      ]
    }
  ]
}