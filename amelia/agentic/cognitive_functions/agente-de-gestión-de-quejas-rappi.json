{
  "functions": [
    {
      "name": "clasificarInteraccionSocial",
      "description": "Clasifica interacciones de redes sociales como ticket válido o comentario general",
      "actionType": "CONSUME_WS_ACTION",
      "consumeWsActionName": "clasificarInteraccionSocial",
      "inputParameters": [
        {
          "name": "contenidoMensaje",
          "description": "Texto del mensaje o comentario del usuario",
          "type": "STRING",
          "required": true
        },
        {
          "name": "redSocial",
          "description": "Plataforma de origen (Twitter, Facebook, Instagram)",
          "type": "STRING",
          "required": true
        },
        {
          "name": "usuarioId",
          "description": "Identificador del usuario en la red social",
          "type": "STRING",
          "required": false
        }
      ],
      "outputParameters": [
        {
          "name": "tipoClasificacion",
          "description": "TICKET_VALIDO o COMENTARIO_GENERAL",
          "type": "STRING"
        },
        {
          "name": "nivelUrgencia",
          "description": "ALTA, MEDIA, BAJA",
          "type": "STRING"
        },
        {
          "name": "categoriaProblema",
          "description": "Categoría identificada del problema",
          "type": "STRING"
        },
        {
          "name": "requiereEscalacion",
          "description": "Indica si necesita escalación inmediata",
          "type": "STRING"
        }
      ]
    },
    {
      "name": "analizarImagenDisputa",
      "description": "Analiza imágenes de disputas para identificar discrepancias en pedidos",
      "actionType": "CONSUME_WS_ACTION",
      "consumeWsActionName": "analizarImagenDisputa",
      "inputParameters": [
        {
          "name": "imagenUrl",
          "description": "URL de la imagen subida por el cliente",
          "type": "STRING",
          "required": true
        },
        {
          "name": "numeroPedido",
          "description": "Número de orden del pedido en disputa",
          "type": "STRING",
          "required": true
        },
        {
          "name": "tipoProductoEsperado",
          "description": "Tipo de producto que debería haber recibido",
          "type": "STRING",
          "required": true
        }
      ],
      "outputParameters": [
        {
          "name": "discrepanciaDetectada",
          "description": "Si se detectó diferencia entre pedido y entrega",
          "type": "STRING"
        },
        {
          "name": "confianzaAnalisis",
          "description": "Porcentaje de confianza del análisis",
          "type": "STRING"
        },
        {
          "name": "tipoProductoDetectado",
          "description": "Producto identificado en la imagen",
          "type": "STRING"
        },
        {
          "name": "recomendacionCompensacion",
          "description": "Tipo de compensación recomendada",
          "type": "STRING"
        }
      ]
    },
    {
      "name": "consultarDetallesPedido",
      "description": "Obtiene información detallada de un pedido específico",
      "actionType": "CONSUME_WS_ACTION",
      "consumeWsActionName": "consultarDetallesPedido",
      "inputParameters": [
        {
          "name": "numeroPedido",
          "description": "Número de orden del pedido",
          "type": "STRING",
          "required": true
        },
        {
          "name": "telefonoCliente",
          "description": "Teléfono del cliente para validación",
          "type": "STRING",
          "required": false
        },
        {
          "name": "numero_pedido",
          "description": "(auto-detected from web action body)",
          "type": "STRING",
          "required": false
        },
        {
          "name": "telefono_cliente",
          "description": "(auto-detected from web action body)",
          "type": "STRING",
          "required": false
        }
      ],
      "outputParameters": [
        {
          "name": "estadoPedido",
          "description": "Estado actual del pedido",
          "type": "STRING"
        },
        {
          "name": "productosOrdenados",
          "description": "Lista de productos en el pedido",
          "type": "STRING"
        },
        {
          "name": "montoTotal",
          "description": "Valor total del pedido",
          "type": "STRING"
        },
        {
          "name": "tiempoEntrega",
          "description": "Tiempo de entrega registrado",
          "type": "STRING"
        },
        {
          "name": "repartidorAsignado",
          "description": "Información del repartidor",
          "type": "STRING"
        }
      ]
    },
    {
      "name": "crearTicketSoporte",
      "description": "Crea un nuevo ticket de soporte para seguimiento",
      "actionType": "CONSUME_WS_ACTION",
      "consumeWsActionName": "crearTicketSoporte",
      "inputParameters": [
        {
          "name": "tipoProblema",
          "description": "Categoría del problema reportado",
          "type": "STRING",
          "required": true
        },
        {
          "name": "descripcionDetallada",
          "description": "Descripción completa del problema",
          "type": "STRING",
          "required": true
        },
        {
          "name": "clienteId",
          "description": "Identificador del cliente",
          "type": "STRING",
          "required": true
        },
        {
          "name": "prioridad",
          "description": "Nivel de prioridad: ALTA, MEDIA, BAJA",
          "type": "STRING",
          "required": true
        },
        {
          "name": "evidenciaAdjunta",
          "description": "URLs de imágenes o archivos adjuntos",
          "type": "STRING",
          "required": false
        }
      ],
      "outputParameters": [
        {
          "name": "numeroTicket",
          "description": "Número único del ticket creado",
          "type": "STRING"
        },
        {
          "name": "estadoTicket",
          "description": "Estado inicial del ticket",
          "type": "STRING"
        },
        {
          "name": "tiempoEstimadoResolucion",
          "description": "Tiempo estimado para resolución",
          "type": "STRING"
        },
        {
          "name": "agenteAsignado",
          "description": "Agente asignado al caso",
          "type": "STRING"
        }
      ]
    }
  ]
}